<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Nudge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background color -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorTheme</item>

        <!-- Inter everywhere: the default font and every Material text style (which name their own font) -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="textAppearanceButton">@style/TextAppearance.Nudge.Button</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Nudge.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Nudge.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Nudge.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Nudge.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Nudge.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Nudge.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Nudge.Caption</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Nudge.Overline</item>
    </style>

    <style name="TextAppearance.Nudge.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.Nudge.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.Nudge.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.Nudge.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.Nudge.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="TextAppearance.Nudge.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.Nudge.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.Nudge.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.Nudge.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
    </style>
</resources>

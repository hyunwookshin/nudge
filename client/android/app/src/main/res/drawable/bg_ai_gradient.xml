<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer gradient (the border) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#7C3AED"
                android:centerColor="#EC4899"
                android:endColor="#22D3EE" />
        </shape>
    </item>

    <!-- Inner solid background (inset to create border thickness) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>

</layer-list>

// Mapping for priority levels to text and colors
const priorityMap = {
     0: { label: "Very High Priority", color: "darkred" },
     1: { label: "High Priority", color: "red" },
     2: { label: "Medium Priority", color: "yellow" },
     3: { label: "Low Priority", color: "green" },
};

// Function to calculate "time from now"
function getTimeFromNow(dateString) {
  const now = new Date();
  const reminderDate = new Date(dateString);
  const diffMs = reminderDate - now;

  if (diffMs < 0) {
    // Past event
    const diffHours = Math.abs(diffMs) / (1000 * 60 * 60);
    if (diffHours < 24) {
      return `${Math.floor(diffHours)} hours ago`;
    } else {
      return `${Math.floor(diffHours / 24)} days ago`;
    }
  } else {
    // Future event
    const diffHours = diffMs / (1000 * 60 * 60);
    if (diffHours < 24) {
      return `in ${Math.ceil(diffHours)} hours`;
    } else {
      return `in ${Math.ceil(diffHours / 24)} days`;
    }
  }
}

// Function to get the day of the week
function getDayOfWeek(dateString) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat("en-US", { weekday: "long" }).format(date);
}

document.getElementById('reminderForm').addEventListener('submit', async function (event) {
  event.preventDefault();

  const title = document.getElementById('title').value;
  const description = document.getElementById('description').value;
  const priority = document.getElementById('priority').value;
  const key = document.getElementById('key').value;
  const dateTime = document.getElementById('dateTime').value; // Input in format YYYY-MM-DDTHH:mm

  if (!dateTime) {
     document.getElementById('response').innerText = 'Please select a date and time.';
     return;
  }

  // Split date and time
  const [date, time] = dateTime.split('T');


  // Ensure time includes seconds
  const timeWithSeconds = `${time}:00`;

  try {
    const response = await fetch('FILL_IN_HOSTNAME' + "/add_reminder", {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        Title: title,
        Description: description,
        Date: date,
        Time: timeWithSeconds,
        Priority: parseInt(priority, 10),
        Key: key,
        Link: '',
      }),
    });

    if (response.ok) {
      document.getElementById('response').innerText = 'Reminder uploaded successfully!';
      location.reload();
    } else {
      document.getElementById('response').innerText = 'Failed to upload reminder.';
    }
  } catch (error) {
    console.error('Error:', error);
    document.getElementById('response').innerText = 'Network error.';
  }
});

// Function to fetch reminders and update the list
function fetchReminders() {
  fetch('FILL_IN_HOSTNAME' + '/reminders')
    .then(response => response.json())
    .then(data => {
      const reminderContainer = document.getElementById('reminderContainer');
      reminderContainer.innerHTML = ''; // Clear previous reminders

      // Sort reminders by date in reverse chronological order
      const sortedReminders = data.reminders.sort((a, b) => {
        const dateA = new Date(a.Time);
        const dateB = new Date(b.Time);
        return dateA - dateB;
      });

      sortedReminders.forEach(reminder => {
        const card = document.createElement('div');
        card.classList.add('reminder-card');
        card.innerHTML = `
          <strong>${reminder.Title}</strong>
          <p>
            ${getDayOfWeek(reminder.Time)} ${new Date(reminder.Time).toLocaleString()} 
            (${getTimeFromNow(reminder.Time)})
          </p>
          <p>${reminder.Description}</p>
          <span class="priority-badge" style="background-color: ${priorityMap[reminder.Priority].color}">
             ${priorityMap[reminder.Priority].label}
          </span>
        `;
        reminderContainer.appendChild(card);
      });
    })
    .catch(error => {
      console.error('Error fetching reminders:', error);
    });
}

// Call fetchReminders when the page loads to display reminders
window.onload = function() {
  fetchReminders();
};
